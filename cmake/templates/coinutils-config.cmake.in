@PACKAGE_INIT@

# Find required dependencies if building static libs
if(NOT @BUILD_SHARED_LIBS@)
    if(@COINUTILS_HAS_ZLIB@)
        find_dependency(ZLIB)
    endif()
    if(@COINUTILS_HAS_BZLIB@)
        find_dependency(BZip2)
    endif()
    if(@COINUTILS_HAS_READLINE@)
        find_dependency(Readline)
    endif()
    if(@COINUTILS_HAS_LAPACK@)
        find_dependency(LAPACK)
    endif()
    if(@COINUTILS_HAS_GLPK@)
        find_dependency(GLPK)
    endif()
endif()

# Include targets
include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@.cmake")

# Include the different configuration files
foreach(CONFIGURATION "${CMAKE_CONFIGURATION_TYPES};noconfig")
    string(TOLOWER ${CONFIGURATION} CONFIGURATION_LOWERCASE)
    set(CONFIG_INCLUDE_PATH "${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@-${CONFIGURATION_LOWERCASE}.cmake")
    if(EXISTS ${CONFIG_INCLUDE_PATH})
        include(${CONFIG_INCLUDE_PATH})
    endif()
endforeach()
