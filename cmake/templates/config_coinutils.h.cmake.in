/* config_coinutils.h.cmake.in */

#ifndef __CONFIG_COINUTILS_H__
#define __CONFIG_COINUTILS_H__

/* Library Visibility Attribute */
#define COINUTILSLIB_EXPORT @COINUTILSLIB_EXPORT@

/* Define to 1 if CoinUtils uses C++11 */
#cmakedefine COINUTILS_CPLUSPLUS11

/* Define to 1 if stdint.h is available for CoinUtils */
#cmakedefine COINUTILS_HAS_STDINT_H

/* Define to 1 if stdint.h is available for CoinUtils */
#cmakedefine COINUTILS_HAS_CSTDINT

/* Define to 1 if CoinUtils was build with Glpk support enabled */
#cmakedefine COINUTILS_HAS_GLPK

/* Define to be the name of C-function for Inf check */
#cmakedefine COINUTILS_C_FINITE @COINUTILS_C_FINITE@

/* Define to be the name of C-function for NaN check */
#cmakedefine COINUTILS_C_ISNAN @COINUTILS_C_ISNAN@

/* Version number of project */
#cmakedefine COINUTILS_VERSION "@COINUTILS_VERSION@"

/* Major Version number of project */
#cmakedefine COINUTILS_VERSION_MAJOR @COINUTILS_VERSION_MAJOR@

/* Minor Version number of project */
#cmakedefine COINUTILS_VERSION_MINOR @COINUTILS_VERSION_MINOR@

/* Release Version number of project */
#cmakedefine COINUTILS_VERSION_RELEASE @COINUTILS_VERSION_RELEASE@

/* Define to 64bit integer type */
#cmakedefine COINUTILS_INT64_T @COINUTILS_INT64_T@

/* Define to integer type capturing pointer */
#cmakedefine COINUTILS_INTPTR_T @COINUTILS_INTPTR_T@

/* Define to 64bit unsigned integer type */
#cmakedefine COINUTILS_UINT64_T @COINUTILS_UINT64_T@

/* Define to type of CoinBigIndex */
#cmakedefine COINUTILS_BIGINDEX_T @COINUTILS_BIGINDEX_T@

/* Define to 1 if CoinBigIndex is int */
#cmakedefine01 COINUTILS_BIGINDEX_IS_INT

#endif
